# ============================================================
# local.env.zsh — Machine-local VARIABLES ONLY (git-ignored)
#
# Copy this file to $ZSH_HOME/local.env.zsh and edit. It is sourced
# EARLY by the orchestrator — right after ZSH_HOME is resolved and
# BEFORE Zinit, tools/*, and derived-path modules load. That means
# overrides here actually take effect for the rest of startup,
# unlike local.zsh (sourced last, see local.zsh.example).
#
# Rules for this file:
#   - export VAR=value statements only.
#   - No aliases, no functions, no command execution, no network,
#     no graphical launches. Put those in local.zsh instead.
# ============================================================

# ---- Optional: relocate the framework root (default: ~/.zsh) ----
# export ZSH_HOME="$HOME/.zsh"

# ---- Optional: relocate the Zinit installation (default: ~/.local/share/zinit/zinit.git) ----
# export ZINIT_HOME="$HOME/.local/share/zinit/zinit.git"

# ---- Optional: OpenCode workflow root ----
# Used by tools/opencode.zsh (oc_* adapters). Defaults to the
# conventional location below; point it at your real checkout.
# export OPENCODE_WORKFLOW_ROOT="$HOME/.agents/skills/vscode-opencode-workflow"
# export OPENCODE_WORKFLOW_SCRIPTS="$OPENCODE_WORKFLOW_ROOT/scripts"

# ---- Optional: Agent skills home (tools/dev-agent.zsh, tools/opencode.zsh) ----
# export AGENT_SKILLS_HOME="$HOME/.agents/skills"

# ---- Optional: Obsidian / Azkaban numbered layout (tools/obsidian/, tools/graphify/) ----
# Defaults match a vault at ~/azkaban with numbered folders. Override here
# if your vault uses a different layout. AZKABAN_VAULT is the canonical
# variable — set it here and Graphify's AZKABAN_DIR follows automatically.
# export AZKABAN_VAULT="$HOME/azkaban"
# export AZKABAN_INBOX_DIR="00_Inbox"
# export AZKABAN_INBOX_FILE="Inbox.md"
# export AZKABAN_DAILY_DIR="01_Daily/Daily Notes"
# export AZKABAN_TASKS_DIR="02_Tasks"
# export AZKABAN_TASKS_FILE="inbox.md"
# export AZKABAN_NOTES_DIR="10_Knowledge_Base/Atomic Notes"
# export AZKABAN_PROJECTS_DIR="05_Projects/Active"
# export AZKABAN_AUTO_OPEN="0"   # 1 = open vault notes in Obsidian after ops

# ---- Optional: Graphify staging/policy knobs (tools/graphify/) ----
# export GRAPHIFY_CODE_STAGE="${XDG_CACHE_HOME:-$HOME/.cache}/graphify-staging"
# export GRAPHIFY_MAX_FILE_SIZE="2097152"   # bytes; files larger than this are skipped
# export GRAPHIFY_KEEP_STAGE="0"            # 1 = keep the staging dir after gfcode runs

# ---- Optional: extra PATH entries (run AFTER framework PATH setup) ----
# export PATH="$HOME/.local/bin:$HOME/.opencode/bin:$PATH"

# ---- Optional: persistent history location/permissions ----
# HISTFILE="$HOME/.zsh_history"
# HISTSIZE=10000
# SAVEHIST=10000

# ---- Optional: tool-specific configuration ----
# export NVM_DIR="$HOME/.nvm"        # nvm home (lazy-loaded on first use)
# export CONDA_ROOT="$HOME/miniconda3"  # searched before the built-in default paths
# export PY_ALLOW_BASE="0"           # 1 = allow py_install/py_pip_install into base env
# export _ZO_DATA_DIR="$HOME/.local/share/zoxide"  # zoxide database location
