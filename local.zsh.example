# ============================================================
# local.zsh — Machine-local aliases & function overrides (git-ignored)
#
# Copy this file to $ZSH_HOME/local.zsh and edit. It is sourced LAST
# by the orchestrator, after every tools/*, aliases.zsh, and
# functions.zsh module — so it's the right place for aliases,
# function overrides, and anything that needs the framework's own
# functions already defined.
#
# For plain variable overrides (AZKABAN_VAULT, ZINIT_HOME, etc.) that
# need to take effect BEFORE Zinit/tools load, use local.env.zsh
# instead — see local.env.zsh.example. Setting a variable here is too
# late to affect anything the framework already derived from it.
# ============================================================

# ---- Example: your own aliases ----
# alias ll='ls -lhF --color=auto'

# ---- Example: override a framework function ----
# dev_clean() {
#   echo "custom dev_clean for this machine"
# }
